# ============================================================
#  Copy this file to `.env` and fill in your own values:
#      cp .env.example .env        (macOS / Linux / Git Bash)
#      copy .env.example .env      (Windows CMD)
#
#  `.env` is git-ignored and must NEVER be committed.
#  This `.env.example` file IS committed so everyone knows
#  which variables the project expects.
#
#  NOTE: every variable below has a safe fallback hard-coded in
#  the source, so the project runs perfectly even without a .env.
#  You only need one when you want to override a value.
# ============================================================

# Port the backend API listens on
PORT=5000

# MongoDB connection string.
# Leave this as-is if you have no local MongoDB installed — the app
# automatically falls back to an in-memory MongoDB server and
# self-seeds, so `npm start` works with zero database setup.
MONGODB_URI=mongodb://127.0.0.1:27017/rajasthan_logistics

# Secret used to sign JWT login tokens.
# CHANGE THIS to a long random string before deploying anywhere public,
# e.g. generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# `development` shows error stack traces + request logs.
# `production` hides them.
NODE_ENV=development
